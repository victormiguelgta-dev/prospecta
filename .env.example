# Copie este arquivo para ".env" e preencha.

# --- Banco (Supabase) --------------------------------------------------------
# Projeto "Prospecta" no Supabase. A URL já está certa.
SUPABASE_URL=https://konlmbxhxyodyshhhhgg.supabase.co
# Chave do banco. Recomendado: a chave "secret" (Supabase > Project Settings >
# API Keys > Secret keys). Ela continua funcionando se um dia você ligar o login
# do painel. NUNCA coloque a chave secret no painel nem no GitHub.
SUPABASE_CHAVE=

# --- IA (opcional, mas recomendada) -----------------------------------------
# Chave grátis em https://aistudio.google.com/apikey
# Com a chave, a IA diz o que vender, acha as dores nas avaliações e pesquisa
# as redes sociais na web. Sem chave, a classificação usa só as regras (custo zero).
GEMINI_API_KEY=
# Se o Google aposentar o modelo, o trabalhador avisa no terminal qual usar.
GEMINI_MODELO=gemini-3.8-flash
