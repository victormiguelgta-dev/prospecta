# Copie este arquivo para ".env" e preencha. Nada aqui é obrigatório para começar.

# --- IA (opcional, mas recomendada) -----------------------------------------
# Chave grátis em https://aistudio.google.com/apikey
# Com a chave, a IA diz o que vender, acha as dores nas avaliações e pesquisa
# as redes sociais na web. Sem chave, a classificação usa só as regras (custo zero).
GEMINI_API_KEY=
# Se o Google aposentar o modelo, o painel avisa no terminal qual usar.
GEMINI_MODELO=gemini-3.8-flash

# --- Seus dados -------------------------------------------------------------
# Aparece na mensagem de WhatsApp ("Meu nome é ...")
SEU_NOME=Victor Miguel

# --- Acesso pelo celular (VPN) -----------------------------------------------
# 127.0.0.1 = o painel só abre neste computador.
# Para abrir pelo celular via Tailscale, coloque o IP do Tailscale deste PC
# (ex.: 100.101.102.103). Nunca deixe o painel aberto na internet: ele não tem senha.
HOST=127.0.0.1
PORTA=8000
