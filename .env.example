# Copie este arquivo para ".env" e preencha. Nada aqui é obrigatório para começar.

# --- IA (opcional) ---------------------------------------------------------
# Chave grátis em https://aistudio.google.com/apikey
# Sem chave, os sites usam os textos padrão de cada nicho (custo zero).
GEMINI_API_KEY=
# Se o Google aposentar o modelo, o painel avisa no console qual usar.
GEMINI_MODELO=gemini-3.8-flash

# --- Netlify (para publicar os demos) ---------------------------------------
# Token: app.netlify.com > User settings > Applications > Personal access tokens
NETLIFY_TOKEN=
# ID do site: crie um site vazio no Netlify e copie o "Site ID" em Site configuration
NETLIFY_SITE_ID=
# Endereço público desse site (vai no link da mensagem do WhatsApp)
URL_DEMOS=https://seus-demos.netlify.app

# --- Seus dados -------------------------------------------------------------
SEU_NOME=Victor Miguel
# Só números, com 55 e DDD. Aparece no botão "Quero este site" dos demos.
SEU_WHATSAPP=
