<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# Prévia particular: não aparece no Google #}
<meta name="robots" content="noindex, nofollow">
<title>{{ lead.nome }}</title>
<meta name="description" content="{{ t.subtitulo }}">
<meta property="og:title" content="{{ lead.nome }}">
<meta property="og:description" content="{{ t.slogan }}">
{% if url_site %}<meta property="og:url" content="{{ url_site }}">{% endif %}
{% if foto or logo %}<meta property="og:image" content="{{ url_site }}{{ foto or logo }}">{% endif %}
<meta name="theme-color" content="{{ cor.destaque }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --destaque: {{ cor.destaque }};
    --sobre-destaque: {{ cor.sobre_destaque }};
    --fundo: {{ cor.fundo }};
    --superficie: {{ cor.superficie }};
    --texto: {{ cor.texto }};
    --suave: {{ cor.texto_suave }};
    --profundo: {{ cor.profundo }};
    --titulo: "Bricolage Grotesque", system-ui, sans-serif;
    --corpo: "Figtree", system-ui, sans-serif;
    --largura: 1120px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--fundo); color: var(--texto); font: 400 1.0625rem/1.65 var(--corpo); -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { font-family: var(--titulo); line-height: 1.05; margin: 0; letter-spacing: -0.02em; }
  p { margin: 0; }
  .contem { width: min(100% - 32px, var(--largura)); margin-inline: auto; }
  :focus-visible { outline: 3px solid var(--destaque); outline-offset: 3px; border-radius: 4px; }

  /* Faixa da prévia */
  .previa { background: var(--profundo); color: #fff; font-size: .875rem; padding: 9px 16px; text-align: center; }
  .previa a { font-weight: 600; text-underline-offset: 3px; }

  /* Cabeçalho */
  .topo { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px; }
  .marca { display: flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--titulo); font-weight: 600; font-size: 1.125rem; line-height: 1.2; }
  .marca img, .marca .iniciais { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; flex: none; }
  .iniciais { display: grid; place-items: center; background: var(--destaque); color: var(--sobre-destaque); font-weight: 800; font-size: 1rem; }

  .botao { display: inline-flex; align-items: center; gap: 10px; padding: 14px 22px; border-radius: 999px; font-weight: 600; text-decoration: none; transition: transform .15s ease, background-color .15s ease; }
  .botao:hover { transform: translateY(-1px); }
  .botao svg { width: 20px; height: 20px; flex: none; }
  .botao-principal { background: var(--destaque); color: var(--sobre-destaque); }
  .botao-linha { border: 1.5px solid currentColor; color: var(--texto); }
  .topo .botao { padding: 10px 18px; font-size: .9375rem; }

  /* Hero: o nome do negócio + a foto real do lugar */
  .hero { display: grid; gap: 40px; padding-block: 32px 72px; align-items: center; }
  .hero h1 { font-size: clamp(2.6rem, 8vw, 5.4rem); font-weight: 800; text-wrap: balance; }
  .hero .slogan { font-family: var(--titulo); font-weight: 600; font-size: clamp(1.25rem, 2.6vw, 1.6rem); color: var(--destaque); margin-top: 18px; line-height: 1.25; }
  .hero .sub { color: var(--suave); margin-top: 14px; max-width: 46ch; }
  .acoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .nota { display: flex; align-items: center; gap: 10px; margin-top: 28px; font-size: .9375rem; color: var(--suave); }
  .nota strong { color: var(--texto); font-size: 1.125rem; font-family: var(--titulo); }
  .estrelas { color: #e9a400; letter-spacing: 2px; }

  .vitrine { position: relative; }
  .vitrine::before { content: ""; position: absolute; inset: 24px -16px -16px 24px; background: var(--destaque); border-radius: 28px; opacity: .9; }
  .vitrine img, .vitrine .sem-foto { position: relative; width: 100%; aspect-ratio: 4 / 3.2; object-fit: cover; border-radius: 28px; }
  .sem-foto { display: grid; place-items: center; background: var(--profundo); color: #fff; }
  .sem-foto img { width: 46%; aspect-ratio: 1; border-radius: 50%; }
  .sem-foto span { font-family: var(--titulo); font-weight: 800; font-size: clamp(4rem, 14vw, 8rem); }

  /* Seções */
  section { padding-block: 72px; }
  .titulo-secao { font-size: clamp(1.9rem, 4.5vw, 2.75rem); font-weight: 800; margin-bottom: 28px; max-width: 18ch; }
  .sobre { display: grid; gap: 40px; }
  .sobre p { font-size: 1.1875rem; max-width: 60ch; }
  .lado-sobre { display: grid; gap: 28px; }
  .detalhe { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 20px; }
  .vitrine .selo-logo { position: absolute; left: -12px; bottom: -12px; width: 96px; height: 96px; aspect-ratio: 1; border-radius: 50%; border: 4px solid var(--fundo); object-fit: cover; }
  .lista-check { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .lista-check li { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; }
  .lista-check svg { width: 24px; height: 24px; flex: none; color: var(--destaque); }

  .servicos { background: var(--superficie); }
  .grade { display: grid; gap: 36px 48px; }
  .servico { border-top: 3px solid var(--destaque); padding-top: 18px; }
  .servico h3 { font-size: 1.375rem; font-weight: 600; margin-bottom: 8px; }
  .servico p { color: var(--suave); }

  .galeria { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  .galeria img { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 16px; }
  .depoimentos { background: var(--superficie); }
  .lista-depo { display: grid; gap: 20px; }
  .lista-depo figure { margin: 0; background: var(--fundo); border-radius: 20px; padding: 26px; display: grid; gap: 14px; align-content: start; }
  .lista-depo blockquote { margin: 0; font-size: 1.0625rem; line-height: 1.6; }
  .lista-depo blockquote::before { content: "“"; display: block; font-family: var(--titulo); font-size: 3.5rem; line-height: .6; color: var(--destaque); margin-bottom: 6px; }
  .lista-depo figcaption { color: var(--suave); font-size: .9375rem; font-weight: 600; }
  .servicos + .galeria-secao { padding-top: 72px; }
  .visita { display: grid; gap: 40px; }
  .info dt { font-weight: 600; margin-top: 22px; }
  .info dt:first-child { margin-top: 0; }
  .info dd { margin: 4px 0 0; color: var(--suave); }
  .horarios { width: 100%; border-collapse: collapse; margin-top: 6px; }
  .horarios td { padding: 6px 0; border-bottom: 1px solid var(--superficie); color: var(--suave); }
  .horarios td:first-child { text-transform: capitalize; color: var(--texto); padding-right: 16px; }
  .mapa { width: 100%; min-height: 340px; border: 0; border-radius: 20px; background: var(--superficie); }

  .chamada { background: var(--profundo) center / cover no-repeat; color: #fff; text-align: left; }
  .chamada .contem { display: grid; gap: 28px; align-items: center; }
  .chamada h2 { font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 800; max-width: 16ch; }
  .chamada .botao-principal { justify-self: start; background: #fff; color: var(--profundo); }

  footer { padding-block: 28px 96px; font-size: .875rem; color: var(--suave); }

  /* Botão flutuante do WhatsApp (celular) */
  .flutuante { position: fixed; right: 16px; bottom: 16px; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #25d366; color: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.25); z-index: 10; }
  .flutuante svg { width: 30px; height: 30px; }

  @media (min-width: 860px) {
    .hero { grid-template-columns: 1.1fr .9fr; padding-block: 48px 96px; }
    .sobre { grid-template-columns: 1.3fr 1fr; align-items: center; }
    .grade { grid-template-columns: repeat(2, 1fr); }
    .visita { grid-template-columns: .8fr 1.2fr; }
    .galeria { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 200px; }
    .galeria img { aspect-ratio: auto; }
    .galeria img:first-child { grid-column: span 2; grid-row: span 2; }
    .galeria.qtd-1 { grid-template-columns: 1fr; grid-auto-rows: 420px; }
    .galeria.qtd-2 { grid-template-columns: 1fr 1fr; grid-auto-rows: 360px; }
    .galeria.qtd-2 img:first-child, .galeria.qtd-1 img:first-child { grid-column: auto; grid-row: auto; }
    .galeria.qtd-3 img:first-child { grid-row: span 2; }
    .galeria.qtd-3 { grid-template-columns: 2fr 1fr; }
    .galeria.qtd-3 img:first-child { grid-column: auto; }
    .galeria.qtd-4 img:first-child { grid-row: span 1; }
    .lista-depo { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .chamada .contem { grid-template-columns: 1fr auto; }
    .flutuante { display: none; }
    footer { padding-bottom: 28px; }
  }
  @media (max-width: 520px) { .topo .botao { display: none; } }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
</style>
</head>
<body>
{% set icone_whats %}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8zm8.4-18.3A11.8 11.8 0 0 0 1.7 17.7L0 24l6.4-1.7A11.8 11.8 0 0 0 24 12c0-3.2-1.2-6.2-3.6-8.5z"/></svg>{% endset %}
{% set icone_tel %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{% endset %}
{% set cta_link = link_whatsapp or link_telefone %}
{% set cta_icone = icone_whats if link_whatsapp else icone_tel %}
{% set icone_check %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke-width="2"/><path d="m8 12.5 2.5 2.5L16 9.5"/></svg>{% endset %}

<div class="previa">
  Prévia de site criada por {{ previa.nome }} para {{ lead.nome }}.
  {% if previa.link %}<a href="{{ previa.link }}" target="_blank" rel="noopener">Quero este site</a>{% endif %}
</div>

<header class="contem topo">
  <a class="marca" href="#">
    {% if logo %}<img src="{{ logo }}" alt="Logo de {{ lead.nome }}">{% else %}<span class="iniciais">{{ iniciais }}</span>{% endif %}
    <span>{{ lead.nome }}</span>
  </a>
  {% if cta_link %}<a class="botao botao-principal" href="{{ cta_link }}" target="_blank" rel="noopener">{{ cta_icone }}{{ "WhatsApp" if link_whatsapp else "Ligar" }}</a>{% endif %}
</header>

<main>
  <div class="contem hero">
    <div>
      <h1>{{ lead.nome }}</h1>
      <p class="slogan">{{ t.slogan }}</p>
      {% if t.subtitulo %}<p class="sub">{{ t.subtitulo }}</p>{% endif %}
      <div class="acoes">
        {% if cta_link %}<a class="botao botao-principal" href="{{ cta_link }}" target="_blank" rel="noopener">{{ cta_icone }}{{ t.cta }}</a>{% endif %}
        <a class="botao botao-linha" href="{{ link_maps }}" target="_blank" rel="noopener">Como chegar</a>
      </div>
      {% if lead.nota %}
      <p class="nota">
        <span class="estrelas" aria-hidden="true">★★★★★</span>
        <span><strong>{{ '%.1f'|format(lead.nota)|replace('.', ',') }}</strong> no Google{% if lead.avaliacoes %}, com {{ lead.avaliacoes }} avaliações{% endif %}</span>
      </p>
      {% endif %}
    </div>
    <div class="vitrine">
      {% if foto %}
        <img src="{{ foto }}" alt="Foto de {{ lead.nome }}">
      {% elif img.fundo %}
        <img src="{{ img.fundo.arquivo }}" alt="{{ img.fundo.descricao }}">
        {% if logo %}<img class="selo-logo" src="{{ logo }}" alt="Logo de {{ lead.nome }}">{% endif %}
      {% elif logo %}
        <div class="sem-foto"><img src="{{ logo }}" alt=""></div>
      {% else %}
        <div class="sem-foto" aria-hidden="true"><span>{{ iniciais }}</span></div>
      {% endif %}
    </div>
  </div>

  {% if t.sobre %}
  <section id="sobre">
    <div class="contem sobre">
      <div>
        <h2 class="titulo-secao">Quem somos</h2>
        <p>{{ t.sobre }}</p>
      </div>
      {% if t.diferenciais or img.detalhe %}
      <div class="lado-sobre">
        {% if img.detalhe %}<img class="detalhe" src="{{ img.detalhe.arquivo }}" alt="{{ img.detalhe.descricao }}" loading="lazy">{% endif %}
        {% if t.diferenciais %}
        <ul class="lista-check">
          {% for d in t.diferenciais %}<li>{{ icone_check }}<span>{{ d }}</span></li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if t.servicos %}
  <section class="servicos" id="servicos">
    <div class="contem">
      <h2 class="titulo-secao">O que oferecemos</h2>
      <div class="grade">
        {% for s in t.servicos %}
        <article class="servico">
          <h3>{{ s.titulo }}</h3>
          <p>{{ s.descricao }}</p>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if galeria %}
  <section class="galeria-secao" id="galeria">
    <div class="contem">
      <h2 class="titulo-secao">Conheça o espaço</h2>
      <div class="galeria qtd-{{ [galeria|length, 5]|min }}">
        {% for g in galeria[:5] %}<img src="{{ g }}" alt="Foto de {{ lead.nome }}" loading="lazy">{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if depoimentos %}
  <section class="depoimentos" id="avaliacoes">
    <div class="contem">
      <h2 class="titulo-secao">O que dizem no Google</h2>
      <div class="lista-depo">
        {% for d in depoimentos[:3] %}
        <figure>
          <span class="estrelas" aria-label="{{ d.estrelas }} estrelas">{{ '★' * d.estrelas }}</span>
          <blockquote>{{ d.texto }}</blockquote>
          <figcaption>{{ d.autor }}, avaliação no Google</figcaption>
        </figure>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section id="visite">
    <div class="contem visita">
      <div>
        <h2 class="titulo-secao">Venha nos visitar</h2>
        <dl class="info">
          {% if lead.endereco %}<dt>Endereço</dt><dd>{{ lead.endereco }}</dd>{% endif %}
          {% if lead.telefone %}<dt>Telefone</dt><dd><a href="{{ link_telefone }}">{{ lead.telefone }}</a></dd>{% endif %}
          {% if lead.horario %}
          <dt>Horário de funcionamento</dt>
          <dd>
            <table class="horarios">
              {% for h in lead.horario %}{% set p = h.split(',', 1) %}
              <tr><td>{{ p[0] }}</td><td>{{ p[1]|trim if p|length > 1 else '' }}</td></tr>
              {% endfor %}
            </table>
          </dd>
          {% endif %}
        </dl>
      </div>
      <iframe class="mapa" src="{{ mapa_embed }}" title="Mapa com a localização de {{ lead.nome }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  {% if cta_link %}
  <section class="chamada"{% if img.textura %} style="background-image: linear-gradient(color-mix(in srgb, var(--profundo) 86%, transparent), color-mix(in srgb, var(--profundo) 86%, transparent)), url('{{ img.textura.arquivo }}')"{% endif %}>
    <div class="contem">
      <h2>Ficou com alguma dúvida? Chame a gente.</h2>
      <a class="botao botao-principal" href="{{ cta_link }}" target="_blank" rel="noopener">{{ cta_icone }}{{ t.cta }}</a>
    </div>
  </section>
  {% endif %}
</main>

<footer class="contem">© {{ ano }} {{ lead.nome }}</footer>

{% if link_whatsapp %}<a class="flutuante" href="{{ link_whatsapp }}" target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">{{ icone_whats }}</a>{% endif %}
</body>
</html>
