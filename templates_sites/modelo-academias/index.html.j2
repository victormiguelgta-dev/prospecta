{# tema: escuro #}
{#
  Template universal de ACADEMIA.
  Usa só o objeto `s` (lista de variáveis no README). Regras:
  - cores: sempre das variáveis s.cor.* (vêm da logo do cliente);
  - slides do topo: primeiro fotos reais (Maps/Instagram), depois s.imagens_pessoas;
  - "Por dentro": SÓ fotos reais (s.galeria);
  - nenhum número inventado: contadores usam nota, avaliações, horas e modalidades reais;
  - planos sem preço: o botão pergunta o valor no WhatsApp.
#}
{%- set slides = [] -%}
{%- if s.foto_real and s.foto_principal %}{% set _ = slides.append(s.foto_principal) %}{% endif -%}
{%- for f in (s.galeria or [])[:2] %}{% set _ = slides.append(f) %}{% endfor -%}
{%- for f in (s.imagens_pessoas or [])[:4] %}{% set _ = slides.append(f) %}{% endfor -%}
{%- if not slides and s.foto_principal %}{% set _ = slides.append(s.foto_principal) %}{% endif -%}
{%- set foto_destaque = (s.imagens_pessoas or [])[0] if s.imagens_pessoas else (s.imagem_detalhe or (s.galeria[0] if s.galeria else none)) -%}
{%- set fundo_chamada = (s.imagens_pessoas or [])[-1] if (s.imagens_pessoas or [])|length > 1 else (s.imagem_textura or s.foto_principal) -%}
{%- set whats = s.link_whatsapp or '' -%}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ s.nome }} | Academia em {{ s.regiao }}</title>
<meta name="description" content="{{ s.subtitulo }}">
<meta property="og:title" content="{{ s.nome }}">
<meta property="og:description" content="{{ s.slogan }}">
{% if s.url_site %}<meta property="og:url" content="{{ s.url_site }}">{% endif %}
{% if slides %}<meta property="og:image" content="{{ s.url_site }}{{ slides[0] }}">{% endif %}
<meta name="theme-color" content="{{ s.cor.fundo }}">
<script>document.documentElement.classList.add("js")</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- Cores tiradas da logo do cliente (preenchidas pelo sistema) -->
<style>
  :root {
    --destaque: {{ s.cor.destaque }};
    --sobre-destaque: {{ s.cor.sobre_destaque }};
    --fundo: {{ s.cor.fundo }};
    --superficie: {{ s.cor.superficie }};
    --texto: {{ s.cor.texto }};
    --suave: {{ s.cor.texto_suave }};
    --linha: color-mix(in srgb, var(--texto) 13%, transparent);
    --titulo: "Big Shoulders Display", Impact, "Arial Narrow", sans-serif;
    --corpo: "Barlow", system-ui, sans-serif;
    --largura: 1200px;
    --faixa-h: 34px;
    --menu-h: 68px;
    --topo-h: calc(var(--faixa-h) + var(--menu-h));
  }
</style>
<link rel="stylesheet" href="css/estilo.css">
</head>
<body>
{% set icone_whats %}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8zm8.4-18.3A11.8 11.8 0 0 0 1.7 17.7L0 24l6.4-1.7A11.8 11.8 0 0 0 24 12c0-3.2-1.2-6.2-3.6-8.5z"/></svg>{% endset %}
{% set icone_check %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{% endset %}
{% set icone_cta %}{% if s.cta_tipo == 'whatsapp' %}{{ icone_whats }}{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{% endif %}{% endset %}

<header class="topo" id="topo">
  <div class="faixa-previa" data-previa>
    <span>Prévia criada por {{ s.previa_nome }} para {{ s.nome }}.</span>
    {% if s.previa_link %}<a href="{{ s.previa_link }}" target="_blank" rel="noopener">Quero este site</a>{% endif %}
  </div>
  <div class="contem">
    <a class="marca" href="#">
      {% if s.logo %}<img src="{{ s.logo }}" alt="Logo {{ s.nome }}">{% else %}<span class="iniciais">{{ s.iniciais }}</span>{% endif %}
      <span>{{ s.nome }}</span>
    </a>
    <nav class="menu" id="menu" aria-label="Seções">
      {% if s.servicos %}<a href="#modalidades">Modalidades</a>{% endif %}
      {% if s.galeria %}<a href="#estrutura">Estrutura</a>{% endif %}
      <a href="#planos">Planos</a>
      <a href="#local">Horários e local</a>
    </nav>
    {% if s.cta_link %}<a class="botao botao-cheio" href="{{ s.cta_link }}" target="_blank" rel="noopener">{{ icone_cta }}Quero treinar aqui</a>{% endif %}
    <button class="abrir-menu" id="abrir-menu" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<main>
  <section class="hero" aria-label="Apresentação">
    <div class="slides">
      {% for img in slides %}<img class="slide{% if loop.first %} ativo{% endif %}" src="{{ img }}" alt="" {% if not loop.first %}loading="lazy"{% endif %}>{% endfor %}
    </div>
    <div class="contem hero-texto">
      <p class="local"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{{ s.categoria }} em {{ s.regiao }}</p>
      <h1{% if s.nome|length > 22 %} class="nome-longo"{% endif %}>{{ s.nome }}</h1>
      <p class="slogan">{{ s.slogan }}</p>
      {% if s.subtitulo %}<p class="sub">{{ s.subtitulo }}</p>{% endif %}
      <div class="acoes">
        {% if s.cta_link %}<a class="botao botao-cheio" href="{{ s.cta_link }}" target="_blank" rel="noopener">{{ icone_cta }}{{ s.cta_texto }}</a>{% endif %}
        <a class="botao botao-vazado" href="#planos">Ver planos</a>
      </div>
      {% if slides|length > 1 %}
      <div class="progresso" id="progresso" aria-label="Fotos">
        {% for img in slides %}<button type="button" aria-label="Foto {{ loop.index }}"></button>{% endfor %}
      </div>
      {% endif %}
    </div>
  </section>

  {# Contadores: só números reais #}
  {%- set numeros = [] -%}
  {%- if s.nota %}{% set _ = numeros.append({'valor': s.nota, 'rotulo': 'de nota no Google'}) %}{% endif -%}
  {%- if s.avaliacoes %}{% set _ = numeros.append({'valor': s.avaliacoes, 'rotulo': 'avaliações de alunos'}) %}{% endif -%}
  {%- if (s.horas_semana or 0) >= 30 %}{% set _ = numeros.append({'valor': s.horas_semana, 'rotulo': 'horas de portas abertas por semana'}) %}{% endif -%}
  {%- if s.servicos %}{% set _ = numeros.append({'valor': s.servicos|length, 'rotulo': 'modalidades para você'}) %}{% endif -%}
  {% if numeros %}
  <div class="numeros">
    <ul class="contem" style="--qtd: {{ numeros|length }}">
      {% for n in numeros %}<li><b data-contar="{{ n.valor }}">{{ n.valor }}</b><span>{{ n.rotulo }}</span></li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if s.servicos %}
  <section id="modalidades">
    <div class="contem">
      <h2 class="titulo-secao revelar">Modalidades</h2>
      <p class="intro-secao revelar">Escolha como quer treinar. A equipe ajuda você a montar a rotina certa para o seu objetivo.</p>
      <div class="grade-modalidades">
        {% for m in s.servicos %}
        <article class="modalidade revelar"><h3>{{ m.titulo }}</h3><p>{{ m.descricao }}</p></article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if s.sobre %}
  <section style="padding-top: 0">
    <div class="contem destaque">
      {% if foto_destaque %}<figure class="revelar"><img src="{{ foto_destaque }}" alt="" loading="lazy"></figure>{% endif %}
      <div class="revelar">
        <h2 class="titulo-secao">Seu treino,<br>seu ritmo</h2>
        <p class="texto-sobre">{{ s.sobre }}</p>
        {% if s.diferenciais %}
        <ul class="lista-dif">{% for d in s.diferenciais %}<li>{{ icone_check }}{{ d }}</li>{% endfor %}</ul>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if s.galeria %}
  <section id="estrutura" style="padding-top: 0">
    <div class="contem">
      <div class="cabeca-carrossel">
        <div>
          <h2 class="titulo-secao revelar">Por dentro da {{ s.nome }}</h2>
          <p class="intro-secao">Fotos reais do espaço.</p>
        </div>
        {% if s.galeria|length > 1 %}
        <div class="setas">
          <button type="button" data-carrossel="-1" aria-label="Foto anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
          <button type="button" data-carrossel="1" aria-label="Próxima foto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
        </div>
        {% endif %}
      </div>
      <div class="carrossel" id="carrossel">
        {% if s.foto_real and s.foto_principal %}<img src="{{ s.foto_principal }}" alt="Foto de {{ s.nome }}" loading="lazy">{% endif %}
        {% for f in s.galeria %}<img src="{{ f }}" alt="Foto de {{ s.nome }}" loading="lazy">{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# Planos: sem preço inventado. O botão pergunta o valor no WhatsApp da academia. #}
  {%- set planos = [
      {'nome': 'Mensal', 'quando': 'Para começar agora e conhecer a academia.', 'itens': ['Acesso no horário de funcionamento', 'Orientação da equipe', 'Sem compromisso longo']},
      {'nome': 'Trimestral', 'quando': 'Para criar o hábito e ver os primeiros resultados.', 'itens': ['Tudo do plano mensal', 'Tempo para evoluir com constância', 'Pergunte pelas condições']},
      {'nome': 'Anual', 'quando': 'Para quem decidiu cuidar da saúde de vez.', 'itens': ['Tudo do plano trimestral', 'Um ano inteiro de treino', 'Pergunte pelas condições']},
  ] -%}
  <section class="planos" id="planos">
    <div class="contem">
      <h2 class="titulo-secao revelar">Planos</h2>
      <p class="intro-secao revelar">Escolha o plano e fale direto com a {{ s.nome }} para saber valores e condições.</p>
      <div class="grade-planos">
        {% for p in planos %}
        <article class="plano revelar{% if loop.index == 2 %} principal{% endif %}">
          <h3>{{ p.nome }}</h3>
          <p class="quando">{{ p.quando }}</p>
          <ul>{% for i in p['itens'] %}<li>{{ icone_check }}<span>{{ i }}</span></li>{% endfor %}</ul>
          <p class="valor">Valor sob consulta</p>
          {% if whats %}
          <a class="botao {% if loop.index == 2 %}botao-cheio{% else %}botao-vazado{% endif %}" target="_blank" rel="noopener"
             href="{{ whats.split('?')[0] }}?text={{ ('Olá! Vi o site e quero saber o valor do plano ' ~ p.nome ~ '.')|urlencode }}">{{ icone_whats }}Quero saber o valor</a>
          {% elif s.cta_link %}
          <a class="botao botao-vazado" href="{{ s.cta_link }}">Ligar para saber o valor</a>
          {% endif %}
        </article>
        {% endfor %}
      </div>
      <p class="aviso-planos">Valores, modalidades incluídas e condições são definidos pela academia.</p>
    </div>
  </section>

  {% if s.depoimentos %}
  <section id="avaliacoes">
    <div class="contem">
      <h2 class="titulo-secao revelar">Quem treina aqui</h2>
      {% if s.nota %}<p class="nota-geral revelar"><b>{{ s.nota }}</b> de nota no Google{% if s.avaliacoes %}, com {{ s.avaliacoes }} avaliações{% endif %}</p>{% endif %}
      <div class="grade-avaliacoes">
        {% for d in s.depoimentos[:3] %}
        <figure class="avaliacao revelar">
          <span class="estrelas" aria-label="{{ d.estrelas }} estrelas">{{ '★' * d.estrelas }}</span>
          <blockquote>{{ d.texto }}</blockquote>
          <figcaption>{{ d.autor }}, avaliação no Google</figcaption>
        </figure>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section id="local" {% if not s.depoimentos %}style="padding-top: 0"{% endif %}>
    <div class="contem local-secao">
      <div>
        <h2 class="titulo-secao revelar">Horários e local</h2>
        {% if s.horarios %}
        <ul class="horarios" id="horarios">
          {% for h in s.horarios %}<li data-dia="{{ h.dia|lower }}"><span>{{ h.dia }}</span><span>{{ h.horas }}</span></li>{% endfor %}
        </ul>
        {% endif %}
        <div class="endereco">
          {% if s.endereco %}<strong>{{ s.endereco }}</strong>{% endif %}
          {% if s.telefone %}<span>{{ s.telefone }}</span>{% endif %}
          <span><a href="{{ s.link_maps }}" target="_blank" rel="noopener">Abrir no Google Maps</a>{% if s.instagram %} · <a href="{{ s.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}</span>
        </div>
      </div>
      <iframe class="mapa" src="{{ s.mapa_embed }}" title="Mapa com a localização de {{ s.nome }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  {% if s.cta_link %}
  <section class="chamada">
    {% if fundo_chamada %}<img class="fundo-chamada" src="{{ fundo_chamada }}" alt="" loading="lazy">{% endif %}
    <div class="contem">
      <h2 class="revelar">Bora começar?</h2>
      <p>Fale com a {{ s.nome }} e agende sua aula experimental.</p>
      <a class="botao botao-cheio" href="{{ s.cta_link }}" target="_blank" rel="noopener">{{ icone_cta }}{{ s.cta_texto }}</a>
    </div>
  </section>
  {% endif %}
</main>

<footer>
  <div class="contem">
    <span>© {{ s.ano }} {{ s.nome }}</span>
    <span>{{ s.regiao }}</span>
  </div>
</footer>

{% if s.link_whatsapp %}<a class="flutuante" href="{{ s.link_whatsapp }}" target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">{{ icone_whats }}</a>{% endif %}

<script src="js/site.js"></script>
</body>
</html>