<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ lead.nome }}</title>
<meta name="description" content="{{ t.subtitulo }}">
<meta property="og:title" content="{{ lead.nome }}">
<meta property="og:description" content="{{ t.slogan }}">
{% if url_site %}<meta property="og:url" content="{{ url_site }}">{% endif %}
{% if foto or logo %}<meta property="og:image" content="{{ url_site }}{{ foto or logo }}">{% endif %}
<meta name="theme-color" content="{{ cor.fundo }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap" rel="stylesheet">
<style>
  :root {
    --destaque: {{ cor.destaque }};
    --sobre-destaque: {{ cor.sobre_destaque }};
    --fundo: {{ cor.fundo }};
    --superficie: {{ cor.superficie }};
    --texto: {{ cor.texto }};
    --suave: {{ cor.texto_suave }};
    --fonte: "Archivo", system-ui, sans-serif;
    --largura: 1180px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--fundo); color: var(--texto); font: 400 1.0625rem/1.6 var(--fonte); font-stretch: 100%; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { margin: 0; font-stretch: 68%; font-weight: 850; line-height: .92; text-transform: uppercase; letter-spacing: -0.005em; }
  p { margin: 0; }
  .contem { width: min(100% - 32px, var(--largura)); margin-inline: auto; }
  :focus-visible { outline: 3px solid var(--destaque); outline-offset: 3px; }

  .previa { background: var(--destaque); color: var(--sobre-destaque); font-size: .875rem; padding: 9px 16px; text-align: center; font-weight: 500; }
  .previa a { font-weight: 700; text-underline-offset: 3px; }

  .botao { display: inline-flex; align-items: center; gap: 10px; padding: 15px 24px; border-radius: 6px; font-weight: 700; font-stretch: 90%; text-decoration: none; font-size: 1.0625rem; transition: transform .15s ease, filter .15s ease; }
  .botao:hover { transform: translateY(-1px); filter: brightness(1.08); }
  .botao svg { width: 20px; height: 20px; flex: none; }
  .botao-principal { background: var(--destaque); color: var(--sobre-destaque); }
  .botao-linha { box-shadow: inset 0 0 0 2px var(--texto); }

  /* Hero: foto do lugar ocupando a tela, nome gigante por cima */
  .hero { position: relative; min-height: min(92vh, 860px); display: flex; flex-direction: column; isolation: isolate; overflow: hidden; }
  .hero-fundo { position: absolute; inset: 0; z-index: -1; }
  .hero-fundo img { width: 100%; height: 100%; object-fit: cover; }
  .hero-fundo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--fundo) 55%, transparent) 0%, color-mix(in srgb, var(--fundo) 35%, transparent) 40%, var(--fundo) 96%); }
  .hero-fundo.sem-foto { background: radial-gradient(120% 90% at 85% 10%, color-mix(in srgb, var(--destaque) 35%, var(--fundo)) 0%, var(--fundo) 60%); }
  .hero-fundo.sem-foto::after { display: none; }

  .topo { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; }
  .marca { display: flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 700; font-stretch: 85%; font-size: 1.0625rem; line-height: 1.15; }
  .marca img, .marca .iniciais { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex: none; }
  .iniciais { display: grid; place-items: center; background: var(--destaque); color: var(--sobre-destaque); font-weight: 900; }
  .topo .botao { padding: 10px 16px; font-size: .9375rem; }

  .hero-texto { margin-top: auto; padding-block: 48px 64px; }
  .hero h1 { font-size: clamp(3.6rem, 15vw, 10rem); max-width: 12ch; text-wrap: balance; }
  .hero .slogan { margin-top: 22px; font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 700; font-stretch: 85%; color: var(--destaque); line-height: 1.2; max-width: 30ch; }
  .hero .sub { margin-top: 10px; color: var(--suave); max-width: 46ch; }
  .acoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  /* Faixa com a nota do Google e os diferenciais */
  .faixa { border-block: 1px solid color-mix(in srgb, var(--texto) 14%, transparent); }
  .faixa ul { list-style: none; margin: 0 auto; padding: 22px 0; display: flex; flex-wrap: wrap; gap: 14px 40px; align-items: center; font-weight: 600; font-stretch: 90%; }
  .faixa li { display: flex; align-items: center; gap: 10px; }
  .faixa li::before { content: ""; width: 8px; height: 8px; background: var(--destaque); transform: rotate(45deg); flex: none; }
  .faixa .nota::before { display: none; }
  .faixa .nota strong { font-size: 1.5rem; font-stretch: 70%; font-weight: 850; color: var(--destaque); }

  section { padding-block: 80px; }
  .titulo-secao { font-size: clamp(2.6rem, 8vw, 4.75rem); margin-bottom: 36px; }

  .sobre { display: grid; gap: 28px; }
  .sobre p { font-size: clamp(1.1875rem, 2.2vw, 1.4rem); line-height: 1.55; max-width: 52ch; color: var(--suave); }
  .sobre p::first-line { color: var(--texto); }

  /* Serviços: lista grande, uma linha por serviço */
  .lista-servicos { list-style: none; margin: 0; padding: 0; border-top: 1px solid color-mix(in srgb, var(--texto) 14%, transparent); }
  .lista-servicos li { display: grid; gap: 6px; padding: 26px 0; border-bottom: 1px solid color-mix(in srgb, var(--texto) 14%, transparent); }
  .lista-servicos h3 { font-size: clamp(1.9rem, 5vw, 3rem); }
  .lista-servicos p { color: var(--suave); max-width: 52ch; }

  .galeria-secao { padding-top: 0; }
  .galeria { display: grid; gap: 6px; grid-template-columns: repeat(2, 1fr); }
  .galeria img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
  .depoimentos figure { margin: 0; padding: 32px 0; border-top: 1px solid color-mix(in srgb, var(--texto) 14%, transparent); display: grid; gap: 14px; }
  .depoimentos blockquote { margin: 0; font-size: clamp(1.25rem, 2.6vw, 1.75rem); line-height: 1.4; font-weight: 500; font-stretch: 90%; max-width: 40ch; }
  .depoimentos figcaption { color: var(--suave); font-weight: 600; }
  .depoimentos .estrelas { color: var(--destaque); letter-spacing: 2px; margin-right: 8px; }
  .visita { background: var(--superficie); }
  .visita .contem { display: grid; gap: 40px; }
  .info { display: grid; gap: 26px; }
  .info h3 { font-size: 1.5rem; margin-bottom: 8px; color: var(--destaque); }
  .info p, .info td { color: var(--suave); }
  .horarios { border-collapse: collapse; width: 100%; }
  .horarios td { padding: 5px 0; border-bottom: 1px solid color-mix(in srgb, var(--texto) 10%, transparent); }
  .horarios td:first-child { color: var(--texto); text-transform: capitalize; padding-right: 16px; }
  .mapa { width: 100%; min-height: 360px; border: 0; border-radius: 8px; filter: grayscale(.4) contrast(1.05); background: var(--fundo); }

  .chamada { text-align: center; background: center / cover no-repeat; }
  .faixa-imagem { margin: 0 auto; width: min(100% - 32px, var(--largura)); }
  .faixa-imagem img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: 8px; }
  @media (max-width: 640px) { .faixa-imagem img { aspect-ratio: 4 / 3; } }
  .chamada h2 { font-size: clamp(2.8rem, 10vw, 6.5rem); max-width: 14ch; margin: 0 auto 32px; }

  footer { padding-block: 28px 100px; color: var(--suave); font-size: .875rem; border-top: 1px solid color-mix(in srgb, var(--texto) 10%, transparent); }

  .flutuante { position: fixed; right: 16px; bottom: 16px; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #25d366; color: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.4); z-index: 10; }
  .flutuante svg { width: 30px; height: 30px; }

  @media (min-width: 860px) {
    .sobre { grid-template-columns: .8fr 1.2fr; align-items: start; }
    .lista-servicos li { grid-template-columns: 1fr 1fr; align-items: baseline; gap: 32px; }
    .visita .contem { grid-template-columns: .8fr 1.2fr; }
    .galeria { grid-template-columns: repeat(3, 1fr); }
    .galeria.qtd-1 { grid-template-columns: 1fr; }
    .galeria.qtd-1 img { aspect-ratio: 21 / 9; }
    .galeria.qtd-2, .galeria.qtd-4 { grid-template-columns: repeat(2, 1fr); }
    .galeria.qtd-2 img, .galeria.qtd-4 img { aspect-ratio: 4 / 3; }
    .galeria.qtd-5 img:first-child { grid-row: span 2; aspect-ratio: auto; height: 100%; }
    .flutuante { display: none; }
    footer { padding-bottom: 28px; }
  }
  @media (max-width: 520px) { .topo .botao { display: none; } }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
</style>
</head>
<body>
{% set icone_whats %}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8zm8.4-18.3A11.8 11.8 0 0 0 1.7 17.7L0 24l6.4-1.7A11.8 11.8 0 0 0 24 12c0-3.2-1.2-6.2-3.6-8.5z"/></svg>{% endset %}
{% set icone_tel %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{% endset %}
{% set cta_link = link_whatsapp or link_telefone %}
{% set cta_icone = icone_whats if link_whatsapp else icone_tel %}

<div class="previa">
  Prévia de site criada por {{ previa.nome }} para {{ lead.nome }}.
  {% if previa.link %}<a href="{{ previa.link }}" target="_blank" rel="noopener">Quero este site</a>{% endif %}
</div>

<header class="hero">
  <div class="hero-fundo{% if not foto and not img.fundo %} sem-foto{% endif %}">{% if foto %}<img src="{{ foto }}" alt="">{% elif img.fundo %}<img src="{{ img.fundo.arquivo }}" alt="">{% endif %}</div>
  <div class="contem topo">
    <a class="marca" href="#">
      {% if logo %}<img src="{{ logo }}" alt="Logo de {{ lead.nome }}">{% else %}<span class="iniciais">{{ iniciais }}</span>{% endif %}
      <span>{{ lead.categoria or nicho.nome }}<br><small style="color:var(--suave);font-weight:500">{{ (lead.regiao or '').split(',')[0] }}</small></span>
    </a>
    {% if cta_link %}<a class="botao botao-principal" href="{{ cta_link }}" target="_blank" rel="noopener">{{ cta_icone }}{{ "WhatsApp" if link_whatsapp else "Ligar" }}</a>{% endif %}
  </div>
  <div class="contem hero-texto">
    <h1>{{ lead.nome }}</h1>
    <p class="slogan">{{ t.slogan }}</p>
    {% if t.subtitulo %}<p class="sub">{{ t.subtitulo }}</p>{% endif %}
    <div class="acoes">
      {% if cta_link %}<a class="botao botao-principal" href="{{ cta_link }}" target="_blank" rel="noopener">{{ cta_icone }}{{ t.cta }}</a>{% endif %}
      <a class="botao botao-linha" href="{{ link_maps }}" target="_blank" rel="noopener">Como chegar</a>
    </div>
  </div>
</header>

<main>
  {% if lead.nota or t.diferenciais %}
  <div class="faixa">
    <ul class="contem">
      {% if lead.nota %}<li class="nota"><strong>{{ '%.1f'|format(lead.nota)|replace('.', ',') }} ★</strong> no Google{% if lead.avaliacoes %} ({{ lead.avaliacoes }} avaliações){% endif %}</li>{% endif %}
      {% for d in t.diferenciais %}<li>{{ d }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if t.sobre %}
  <section>
    <div class="contem sobre">
      <h2 class="titulo-secao">Quem somos</h2>
      <p>{{ t.sobre }}</p>
    </div>
  </section>
  {% endif %}

  {% if img.detalhe %}
  <figure class="faixa-imagem"><img src="{{ img.detalhe.arquivo }}" alt="{{ img.detalhe.descricao }}" loading="lazy"></figure>
  {% endif %}

  {% if t.servicos %}
  <section{% if not img.detalhe %} style="padding-top:0"{% endif %}>
    <div class="contem">
      <h2 class="titulo-secao">O que tem aqui</h2>
      <ul class="lista-servicos">
        {% for s in t.servicos %}
        <li><h3>{{ s.titulo }}</h3><p>{{ s.descricao }}</p></li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if galeria %}
  <section class="galeria-secao">
    <div class="contem">
      <h2 class="titulo-secao">Por dentro</h2>
      <div class="galeria qtd-{{ [galeria|length, 6]|min }}">
        {% for g in galeria[:6] %}<img src="{{ g }}" alt="Foto de {{ lead.nome }}" loading="lazy">{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if depoimentos %}
  <section class="depoimentos">
    <div class="contem">
      <h2 class="titulo-secao">Quem frequenta</h2>
      {% for d in depoimentos[:3] %}
      <figure>
        <blockquote>{{ d.texto }}</blockquote>
        <figcaption><span class="estrelas" aria-label="{{ d.estrelas }} estrelas">{{ '★' * d.estrelas }}</span> {{ d.autor }}, no Google</figcaption>
      </figure>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="visita">
    <div class="contem">
      <div class="info">
        <h2 class="titulo-secao" style="margin-bottom:0">Onde estamos</h2>
        {% if lead.endereco %}<div><h3>Endereço</h3><p>{{ lead.endereco }}</p></div>{% endif %}
        {% if lead.telefone %}<div><h3>Telefone</h3><p><a href="{{ link_telefone }}">{{ lead.telefone }}</a></p></div>{% endif %}
        {% if lead.horario %}
        <div>
          <h3>Horário</h3>
          <table class="horarios">
            {% for h in lead.horario %}{% set p = h.split(',', 1) %}
            <tr><td>{{ p[0] }}</td><td>{{ p[1]|trim if p|length > 1 else '' }}</td></tr>
            {% endfor %}
          </table>
        </div>
        {% endif %}
      </div>
      <iframe class="mapa" src="{{ mapa_embed }}" title="Mapa com a localização de {{ lead.nome }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  {% if cta_link %}
  <section class="chamada"{% if img.textura %} style="background-image: linear-gradient(color-mix(in srgb, var(--fundo) 84%, transparent), var(--fundo)), url('{{ img.textura.arquivo }}')"{% endif %}>
    <div class="contem">
      <h2>{{ t.slogan }}</h2>
      <a class="botao botao-principal" href="{{ cta_link }}" target="_blank" rel="noopener">{{ cta_icone }}{{ "Chamar no WhatsApp" if link_whatsapp else "Ligar agora" }}</a>
    </div>
  </section>
  {% endif %}
</main>

<footer><div class="contem">© {{ ano }} {{ lead.nome }}</div></footer>

{% if link_whatsapp %}<a class="flutuante" href="{{ link_whatsapp }}" target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">{{ icone_whats }}</a>{% endif %}
</body>
</html>
